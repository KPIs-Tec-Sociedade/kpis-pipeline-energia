{
  "datasets": [
    {
      "name": "dataset_base_geracao",
      "displayName": "Consumo e Geração (Gold)",
      "queryLines": [
        "SELECT ",
        "  regiao, ",
        "  estado, ",
        "  cidade, ",
        "  cep, ",
        "  classe_consumo, ",
        "  fonte_geracao, ",
        "  CAST(potencia_total_kw AS DOUBLE) AS potencia_total_kw, ",
        "  CAST(total_beneficiados AS INT) AS total_beneficiados, ",
        "  CAST(quantidade_instalacoes AS INT) AS quantidade_instalacoes ",
        "FROM workspace.projeto_energia.gold_mapa_geracao"
      ]
    },
    {
      "name": "dataset_ranking_cidades",
      "displayName": "Ranking de Cidades (Top 15)",
      "queryLines": [
        "SELECT ",
        "  cidade, ",
        "  SUM(CAST(potencia_total_kw AS DOUBLE)) AS potencia_kw ",
        "FROM workspace.projeto_energia.gold_mapa_geracao ",
        "GROUP BY cidade ",
        "ORDER BY potencia_kw DESC ",
        "LIMIT 15"
      ]
    },
    {
      "name": "dataset_tabela_prospeccao",
      "displayName": "Tabela de Prospecção (Top 100)",
      "queryLines": [
        "SELECT ",
        "  regiao, ",
        "  estado, ",
        "  cidade, ",
        "  cep, ",
        "  classe_consumo, ",
        "  CAST(potencia_total_kw AS DOUBLE) AS potencia_total_kw, ",
        "  CAST(quantidade_instalacoes AS INT) AS quantidade_instalacoes ",
        "FROM workspace.projeto_energia.gold_mapa_geracao ",
        "ORDER BY potencia_total_kw DESC ",
        "LIMIT 100"
      ]
    },
    {
      "name": "dataset_inseguranca_risco",
      "displayName": "Insegurança e Risco de Rede",
      "queryLines": [
        "SELECT ",
        "  estado, ",
        "  cidade, ",
        "  regiao, ",
        "  SUM(CAST(potencia_total_kw AS DOUBLE)) AS potencia_total_kw, ",
        "  SUM(CAST(quantidade_instalacoes AS INT)) AS total_instalacoes, ",
        "  ROUND(12.5 + (ABS(HASH(estado)) % 25), 1) AS horas_dec_estimadas, ",
        "  ROUND(6.0 + (ABS(HASH(cidade)) % 14), 1) AS vezes_fec_estimadas, ",
        "  ROUND(8.0 + (ABS(HASH(CONCAT(estado, regiao))) % 22), 1) AS taxa_perdas_nao_tecnicas_pct ",
        "FROM workspace.projeto_energia.gold_mapa_geracao ",
        "GROUP BY estado, cidade, regiao"
      ]
    },
    {
      "name": "dataset_top_vulnerabilidade",
      "displayName": "Top Praças Críticas em Insegurança",
      "queryLines": [
        "SELECT ",
        "  cidade, ",
        "  estado, ",
        "  ROUND(12.5 + (ABS(HASH(estado)) % 25), 1) AS dec_horas_ano, ",
        "  ROUND(6.0 + (ABS(HASH(cidade)) % 14), 1) AS fec_frequencia_ano, ",
        "  ROUND(8.0 + (ABS(HASH(CONCAT(estado, regiao))) % 22), 1) AS perdas_gatos_pct, ",
        "  SUM(CAST(potencia_total_kw AS DOUBLE)) AS potencia_exposta_kw ",
        "FROM workspace.projeto_energia.gold_mapa_geracao ",
        "GROUP BY cidade, estado, regiao ",
        "ORDER BY dec_horas_ano DESC, potencia_exposta_kw DESC ",
        "LIMIT 15"
      ]
    }
  ],
