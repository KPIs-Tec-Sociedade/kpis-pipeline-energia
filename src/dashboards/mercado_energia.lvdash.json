              "frame": { "showTitle": true, "title": "Forecast de Demanda (Série Mensal Consolidada vs. Projeção IA 12 Meses)" }
            }
          },
          "position": { "x": 0, "y": 0, "width": 6, "height": 5 }
        },
        {
          "widget": {
            "name": "tabela_recomendacao_ia",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset_ml_tabela_prioritaria",
                  "fields": [
                    { "name": "cidade", "expression": "`cidade`" },
                    { "name": "estado", "expression": "`estado`" },
                    { "name": "score_propensao_bess", "expression": "`score_propensao_bess`" },
                    { "name": "prioridade_bess", "expression": "`prioridade_bess`" },
                    { "name": "dec_horas_ano", "expression": "`dec_horas_ano`" },
                    { "name": "potencia_prevista_12m_kw", "expression": "`potencia_prevista_12m_kw`" },
                    { "name": "capacidade_bess_sugerida_mwh", "expression": "`capacidade_bess_sugerida_mwh`" },
                    { "name": "recomendacao_alocacao", "expression": "`recomendacao_alocacao`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "cidade", "type": "string", "displayAs": "string", "visible": true, "title": "Cidade" },
