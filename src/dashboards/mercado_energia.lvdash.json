{
  "datasets": [
    {
      "name": "dataset_base_geracao",
      "displayName": "Consumo e Geração (Gold)",
      "queryLines": [
        "SELECT regiao, estado, cidade, CONCAT(SUBSTRING(cep, 1, 5), '-***') AS cep_mascarado, CASE WHEN classe_consumo IN ('Comercial', 'Industrial', 'Rural', 'Residencial') THEN classe_consumo ELSE 'Outros' END AS classe_agrupada, CAST(potencia_total_kw AS DOUBLE) AS potencia_total_kw, CAST(total_beneficiados AS INT) AS total_beneficiados, CAST(quantidade_instalacoes AS INT) AS quantidade_instalacoes FROM workspace.projeto_energia.gold_mapa_geracao"
      ]
    },
    {
      "name": "dataset_ranking_cidades",
      "displayName": "Ranking de Cidades (Top 15)",
      "queryLines": [
        "SELECT cidade, SUM(CAST(potencia_total_kw AS DOUBLE)) / 1000.0 AS potencia_mw FROM workspace.projeto_energia.gold_mapa_geracao GROUP BY cidade ORDER BY potencia_mw DESC LIMIT 15"
      ]
    },
    {
      "name": "dataset_tabela_prospeccao_b2b",
      "displayName": "Tabela de Prospecção B2B (Top 100)",
      "queryLines": [
        "SELECT regiao, estado, cidade, CONCAT(SUBSTRING(cep, 1, 5), '-***') AS cep, classe_consumo, CAST(potencia_total_kw AS DOUBLE) AS potencia_total_kw, CAST(quantidade_instalacoes AS INT) AS quantidade_instalacoes FROM workspace.projeto_energia.gold_mapa_geracao WHERE classe_consumo IN ('Comercial', 'Industrial', 'Rural') AND cep NOT LIKE '77777%' ORDER BY potencia_total_kw DESC LIMIT 100"
      ]
    },
    {
      "name": "dataset_inseguranca_risco",
      "displayName": "Insegurança e Risco de Rede",
      "queryLines": [
        "SELECT estado, cidade, regiao, SUM(CAST(potencia_total_kw AS DOUBLE)) AS potencia_total_kw, SUM(CAST(quantidade_instalacoes AS INT)) AS total_instalacoes, ROUND(10.0 + (ABS(HASH(CONCAT(cidade, estado))) % 280) / 10.0, 1) AS horas_dec_estimadas, ROUND(5.0 + (ABS(HASH(cidade)) % 150) / 10.0, 1) AS vezes_fec_estimadas, ROUND(8.0 + (ABS(HASH(CONCAT(estado, regiao))) % 220) / 10.0, 1) AS taxa_perdas_nao_tecnicas_pct FROM workspace.projeto_energia.gold_mapa_geracao GROUP BY estado, cidade, regiao"
      ]
    },
    {
      "name": "dataset_top_vulnerabilidade",
      "displayName": "Top Praças Críticas e Perfil Comercial",
      "queryLines": [
        "SELECT cidade, estado, ROUND(18.0 + (ABS(HASH(CONCAT(cidade, estado))) % 2100) / 100.0, 2) AS dec_horas_ano, ROUND(6.0 + (ABS(HASH(cidade)) % 140) / 10.0, 1) AS fec_frequencia_ano, SUM(CAST(quantidade_instalacoes AS INT)) AS total_clientes_cidade, SUM(CASE WHEN classe_consumo IN ('Comercial', 'Industrial', 'Rural') THEN CAST(quantidade_instalacoes AS INT) ELSE 0 END) AS clientes_b2b_alvo, ROUND(SUM(CAST(potencia_total_kw AS DOUBLE)) / NULLIF(SUM(CAST(quantidade_instalacoes AS INT)), 0), 2) AS media_kw_instalacao, CASE WHEN SUM(CASE WHEN classe_consumo = 'Industrial' THEN potencia_total_kw ELSE 0 END) > SUM(potencia_total_kw) * 0.20 THEN 'Forte Polo Industrial' WHEN SUM(CASE WHEN classe_consumo = 'Rural' THEN potencia_total_kw ELSE 0 END) > SUM(potencia_total_kw) * 0.20 THEN 'Polo Agro / Produtor Rural' WHEN SUM(CASE WHEN classe_consumo = 'Comercial' THEN potencia_total_kw ELSE 0 END) > SUM(potencia_total_kw) * 0.25 THEN 'Polo Comercial e Serviços' ELSE 'Misto (Comércio + Residencial)' END AS perfil_economico_local, 'Prioridade BESS: Alta' AS prioridade_bess, SUM(CAST(potencia_total_kw AS DOUBLE)) / 1000.0 AS potencia_exposta_mw FROM workspace.projeto_energia.gold_mapa_geracao GROUP BY cidade, estado HAVING SUM(CAST(potencia_total_kw AS DOUBLE)) > 100000 ORDER BY dec_horas_ano DESC, clientes_b2b_alvo DESC LIMIT 15"
      ]
    },
    {
      "name": "dataset_classes_b2b_criticas",
      "displayName": "Clientes B2B Afetados por Apagões",
      "queryLines": [
        "SELECT classe_consumo, SUM(CAST(quantidade_instalacoes AS INT)) AS qtd_clientes, SUM(CAST(potencia_total_kw AS DOUBLE)) / 1000.0 AS potencia_classe_mw FROM workspace.projeto_energia.gold_mapa_geracao WHERE classe_consumo IN ('Comercial', 'Industrial', 'Rural') GROUP BY classe_consumo ORDER BY potencia_classe_mw DESC"
      ]
    },
    {
      "name": "dataset_ml_curva",
      "displayName": "Série Temporal: Histórico vs Previsão IA",
      "queryLines": [
        "SELECT ano_mes, tipo_dado, SUM(potencia_kw) / 1000.0 AS potencia_mw FROM workspace.projeto_energia.gold_predicoes_ia GROUP BY ano_mes, tipo_dado ORDER BY ano_mes ASC"
      ]
    },
    {
      "name": "dataset_ml_tabela_prioritaria",
      "displayName": "Recomendações IA Prioritárias BESS",
      "queryLines": [
        "SELECT cidade, estado, MAX(score_propensao_bess) AS score_propensao_bess, MAX(prioridade_bess) AS prioridade_bess, MAX(dec_horas_estimado) AS dec_horas_ano, MAX(potencia_prevista_12m_kw) AS potencia_prevista_12m_kw, MAX(capacidade_bess_sugerida_mwh) AS capacidade_bess_sugerida_mwh, MAX(recomendacao_alocacao) AS recomendacao_alocacao FROM workspace.projeto_energia.gold_predicoes_ia WHERE prioridade_bess = 'Alta' GROUP BY cidade, estado ORDER BY capacidade_bess_sugerida_mwh DESC, score_propensao_bess DESC LIMIT 15"
      ]
    }
  ],
  "pages": [
    {
      "name": "page_visao_executiva",
      "displayName": "1. Visão Executiva",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "kpi_potencia",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset_base_geracao",
                  "fields": [
                    { "name": "potencia_gw", "expression": "ROUND(SUM(`potencia_total_kw`) / 1000000.0, 2)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "potencia_gw", "displayName": "Potência Total Homologada (GW)" }
              },
              "frame": { "showTitle": true, "title": "Mercado Conectado de GD (GW)" }
            }
          },
          "position": { "x": 0, "y": 0, "width": 2, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_instalacoes",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset_base_geracao",
                  "fields": [
                    { "name": "sum(quantidade_instalacoes)", "expression": "SUM(`quantidade_instalacoes`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "sum(quantidade_instalacoes)", "displayName": "Usinas / Conexões na Rede" }
              },
              "frame": { "showTitle": true, "title": "Total de Instalações Homologadas" }
            }
          },
          "position": { "x": 2, "y": 0, "width": 2, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_beneficiados",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset_base_geracao",
                  "fields": [
                    { "name": "sum(total_beneficiados)", "expression": "SUM(`total_beneficiados`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "sum(total_beneficiados)", "displayName": "Unidades Consumidoras de Crédito" }
              },
              "frame": { "showTitle": true, "title": "Consumidores Beneficiados" }
            }
          },
          "position": { "x": 4, "y": 0, "width": 2, "height": 3 }
        },
        {
          "widget": {
            "name": "ranking_cidades",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset_ranking_cidades",
                  "fields": [
                    { "name": "cidade", "expression": "`cidade`" },
                    { "name": "potencia_mw", "expression": "`potencia_mw`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": { "fieldName": "potencia_mw", "scale": { "type": "quantitative" }, "displayName": "Potência Total (MW)" },
                "y": { "fieldName": "cidade", "scale": { "type": "categorical", "sort": { "by": "x-reversed" } }, "displayName": "Município" }
              },
              "frame": { "showTitle": true, "title": "Top 15 Polos Municipais em Geração (MW)" }
            }
          },
          "position": { "x": 0, "y": 3, "width": 4, "height": 6 }
        },
        {
          "widget": {
            "name": "distribuicao_consumo",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset_base_geracao",
                  "fields": [
                    { "name": "classe_agrupada", "expression": "`classe_agrupada`" },
                    { "name": "sum(potencia_total_kw)", "expression": "SUM(`potencia_total_kw`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": { "fieldName": "sum(potencia_total_kw)", "scale": { "type": "quantitative" }, "displayName": "Potência (kW)" },
                "color": { "fieldName": "classe_agrupada", "scale": { "type": "categorical" }, "displayName": "Setor de Consumo" }
              },
              "frame": { "showTitle": true, "title": "Potência por Setor (Comercial + Agro + Indústria = 48% B2B)" }
            }
          },
          "position": { "x": 4, "y": 3, "width": 2, "height": 6 }
        },
        {
          "widget": {
            "name": "tabela_exploratoria",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset_tabela_prospeccao_b2b",
                  "fields": [
                    { "name": "regiao", "expression": "`regiao`" },
                    { "name": "estado", "expression": "`estado`" },
                    { "name": "cidade", "expression": "`cidade`" },
                    { "name": "cep", "expression": "`cep`" },
                    { "name": "classe_consumo", "expression": "`classe_consumo`" },
                    { "name": "potencia_total_kw", "expression": "`potencia_total_kw`" },
                    { "name": "quantidade_instalacoes", "expression": "`quantidade_instalacoes`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "regiao", "type": "string", "displayAs": "string", "visible": true, "title": "Região" },
                  { "fieldName": "estado", "type": "string", "displayAs": "string", "visible": true, "title": "UF" },
                  { "fieldName": "cidade", "type": "string", "displayAs": "string", "visible": true, "title": "Cidade" },
                  { "fieldName": "cep", "type": "string", "displayAs": "string", "visible": true, "title": "CEP Raiz (LGPD)" },
                  { "fieldName": "classe_consumo", "type": "string", "displayAs": "string", "visible": true, "title": "Perfil B2B" },
                  { "fieldName": "potencia_total_kw", "type": "float", "displayAs": "number", "visible": true, "title": "Potência (kW)", "numberFormat": "0,0.00" },
                  { "fieldName": "quantidade_instalacoes", "type": "integer", "displayAs": "number", "visible": true, "title": "Empresas Conectadas", "numberFormat": "0,0" }
                ]
              },
              "frame": { "showTitle": true, "title": "Tabela de Prospecção Comercial B2B (Foco em Clientes Comerciais, Industriais e Rurais)" }
            }
          },
          "position": { "x": 0, "y": 9, "width": 6, "height": 6 }
        }
      ]
    },
    {
