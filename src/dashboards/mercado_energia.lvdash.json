                    { "name": "perfil_economico_local", "expression": "`perfil_economico_local`" },
                    { "name": "total_clientes_cidade", "expression": "`total_clientes_cidade`" },
                    { "name": "clientes_b2b_alvo", "expression": "`clientes_b2b_alvo`" },
                    { "name": "media_kw_instalacao", "expression": "`media_kw_instalacao`" },
                    { "name": "dec_horas_ano", "expression": "`dec_horas_ano`" },
